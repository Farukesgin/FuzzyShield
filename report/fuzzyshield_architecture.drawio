          vertex="1" parent="20">
          <mxGeometry x="15" y="102" width="250" height="45" as="geometry" />
        </mxCell>
        <mxCell id="23"
          value="μ(ent=max) = 0.92&#xa;trapmf[7.2,7.7,8.0,8.0]"
