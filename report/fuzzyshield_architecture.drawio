          value="Step 3 · Rule Evaluation (R1)"
          style="swimlane;fontStyle=1;fontSize=12;
                 fillColor=#fff2cc;strokeColor=#d6b656;startSize=30;"
          vertex="1" parent="1">
          <mxGeometry x="630" y="80" width="310" height="220" as="geometry" />
        </mxCell>
        <mxCell id="31"
          value="Rule R1:&#xa;IF fwrite=extreme&#xa;AND ext=many&#xa;AND ent=max&#xa;THEN ransomware=critical"
